# Runtime: development locally; set production only behind HTTPS and with PostgreSQL.
ENVIRONMENT=development

# Database: PostgreSQL in Docker; SQLite is used for local development.
DATABASE_URL=sqlite:///./codeguard.db

POSTGRES_PASSWORD=replace-with-a-strong-database-password

# REQUIRED before deployment: generate a long random secret (at least 32 random bytes).
JWT_SECRET=replace-with-a-long-random-secret-before-deployment
ACCESS_TOKEN_MINUTES=30
RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=8
MAX_REQUEST_BODY_BYTES=1000000
TRUSTED_HOSTS=localhost,127.0.0.1
ENABLE_HSTS=false
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Optional first-run administrator bootstrap. Keep these out of source control.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FULL_NAME=CodeGuard Administrator

AI_FALLBACK_ORDER=openai,gemini,ollama
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5-coder:7b

# Optional GitHub App integration (private key PEM; store securely, never commit real keys)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
