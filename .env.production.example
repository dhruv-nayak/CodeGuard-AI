# Copy to .env on the deployment host. Replace every placeholder.
ENVIRONMENT=production
DATABASE_URL=postgresql+psycopg://codeguard:REPLACE_WITH_DB_PASSWORD@db:5432/codeguard
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD_AT_LEAST_20_CHARS
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
ACCESS_TOKEN_MINUTES=30
RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=8
MAX_REQUEST_BODY_BYTES=1000000
CORS_ORIGINS=https://codeguard.example.com
TRUSTED_HOSTS=codeguard.example.com,localhost,127.0.0.1
ENABLE_HSTS=true
FORWARDED_ALLOW_IPS=127.0.0.1

# Optional initial administrator. Leave blank if provisioning another way.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FULL_NAME=CodeGuard Administrator

# Optional AI providers. Do not enable until data-processing terms are reviewed.
AI_FALLBACK_ORDER=openai,gemini,ollama
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5-coder:7b

# Optional GitHub App. Keep the private key in a secret manager where possible.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
